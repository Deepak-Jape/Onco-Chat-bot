# OncoSuite environment configuration for the VM.
# Copy to /etc/oncosuite/oncosuite.env on the VM, fill in real values, chmod 600.
# The systemd unit loads this via EnvironmentFile.

# --- Server bind (behind Caddy; localhost only, distinct port from HRMS :8000) ---
ONCOSUITE_HOST=127.0.0.1
ONCOSUITE_PORT=8010

# --- Path prefix ---
# The VM's Caddy proxies /chat-bot* to this app unchanged (same convention as
# its other services); the app strips the prefix itself. See
# deploy/caddy-oncosuite-snippet.txt for the exact Caddy route.
ONCOSUITE_BASE_PATH=/chat-bot

# --- CORS ---
# Not needed in the standard deploy -- Caddy serves ctsearch and proxies
# /chat-bot* on the SAME origin (204.168.157.213.sslip.io), so the browser
# never makes a cross-origin request. Only set this (comma-separated, or "*")
# for local dev against a remote API from a different origin.
# ONCOSUITE_CORS_ORIGINS=

# --- Database (shared VM Postgres; oncosuite_gold data) ---
# The app connects READ-ONLY. Use a dedicated read-only DB role in production,
# NOT the postgres superuser. Point host at the shared VM's Postgres.
ONCOSUITE_DSN=host=127.0.0.1 dbname=oncosuite_new user=oncosuite_ro password=CHANGE_ME

# --- LLM backend ---
ONCOSUITE_LLM_BACKEND=deepseek
# ROTATE THIS: the repo has a fallback dev key committed -- issue a fresh key and set it here.
DEEPSEEK_API_KEY=CHANGE_ME
DEEPSEEK_MODEL=deepseek-v4-flash

# --- Embeddings backend (Ollama, for semantic search / RAG) ---
# Semantic search + CSV RAG need Ollama running with an embed model on the VM.
# If Ollama is not installed, the app still works (keyword + SQL + general-knowledge);
# only the vector/RAG path degrades gracefully.
OLLAMA_HOST=http://127.0.0.1:11434

# --- Never expose internal debug banner in production ---
# (leave unset; setting it to 1 would show intent/tool routing to users)
# ONCOSUITE_DEBUG_BANNER=0
